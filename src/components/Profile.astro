---
import type { Content } from '../content/types';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { hero, sections, career, repos, contact } = content;

const num = (i: number) => String(i + 1).padStart(2, '0');
const careerIndex = sections.length;
const reposIndex = sections.length + 1;
---

<header class="wrap">
  <div class="hero">
    <div class="hero__intro">
      <h1 class="hero__name">{hero.name}</h1>
      <p class="hero__role">{hero.role}</p>
      <ul class="hero__facts">
        {hero.facts.map((fact) => <li>{fact}</li>)}
      </ul>
      {hero.lead.map((p) => <p class="hero__lead">{p}</p>)}
    </div>

    <div class="hero__portrait">
      <picture>
        <source srcset="/frank-trauernicht.avif" type="image/avif" />
        <source srcset="/frank-trauernicht.webp" type="image/webp" />
        <img
          src="/frank-trauernicht.jpg"
          alt={hero.photoAlt}
          width="640"
          height="800"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
  </div>
</header>

<main id="main">
  <div class="wrap">
    {
      sections.map((section, i) => (
        <section class="section" id={section.id} aria-labelledby={`h-${section.id}`}>
          <div class="section__head">
            <span class="section__eyebrow" aria-hidden="true">
              {num(i)}
            </span>
            <h2 class="section__heading" id={`h-${section.id}`}>
              {section.heading}
            </h2>
          </div>
          <div class="section__body">
            {section.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
            {section.listIntro && <p class="list-intro">{section.listIntro}</p>}
            {section.list && (
              <ul class="work-grid">
                {section.list.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            {section.afterList?.map((p) => <p>{p}</p>)}
          </div>
        </section>
      ))
    }

    <section class="section" id="werdegang" aria-labelledby="h-werdegang">
      <div class="section__head">
        <span class="section__eyebrow" aria-hidden="true">{num(careerIndex)}</span>
        <h2 class="section__heading" id="h-werdegang">{career.heading}</h2>
      </div>
      <div class="section__body">
      <ol class="career">
        {
          career.stations.map((station) => (
            <li>
              <div class="career__period">{station.period}</div>
              <div>
                <p class="career__role">
                  {station.role}
                  {station.org && (
                    <>
                      {' · '}
                      <span class="career__org">{station.org}</span>
                    </>
                  )}
                </p>
                {station.note && <p class="career__note">{station.note}</p>}
              </div>
            </li>
          ))
        }
      </ol>
      </div>
    </section>

    <section class="section" id="repositories" aria-labelledby="h-repositories">
      <div class="section__head">
        <span class="section__eyebrow" aria-hidden="true">{num(reposIndex)}</span>
        <h2 class="section__heading" id="h-repositories">{repos.heading}</h2>
      </div>
      <div class="section__body">
      {repos.intro.map((p) => <p>{p}</p>)}
      <ul class="repos">
        {
          repos.items.map((repo) => (
            <li>
              <a href={repo.url} rel="me noopener">
                {repo.name}
              </a>
              <p>{repo.text}</p>
            </li>
          ))
        }
      </ul>
      </div>
    </section>

    <section class="section section--contact" id="kontakt" aria-labelledby="h-kontakt">
      <h2 class="section__heading" id="h-kontakt">{contact.heading}</h2>
      {contact.paragraphs.map((p) => <p>{p}</p>)}
      <p>
        <a class="contact-mail" href={`mailto:${contact.email}`}>{contact.email}</a>
      </p>
      <div class="profiles">
        {
          contact.profiles.map((profile) => (
            <a href={profile.url} rel="me noopener">
              {profile.label}
            </a>
          ))
        }
      </div>
    </section>
  </div>
</main>
