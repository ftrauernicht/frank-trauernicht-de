---
import Base from '../layouts/Base.astro';
import CacheListing from '../components/CacheListing.astro';
import { de } from '../content/de';
import { cacheDe } from '../content/cache';
---

<Base
  content={de}
  path="/cache/"
  altPath="/en/cache/"
  title={cacheDe.metaTitle}
  description={cacheDe.metaDescription}
  noindex
>
  <CacheListing cache={cacheDe} />
</Base>
